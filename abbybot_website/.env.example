# AbbyBot Discord database (discord)
DISCORD_DB_HOST=discord.example.com
DISCORD_DB_USER=discordUser
DISCORD_DB_PASSWORD=discordPassword
DISCORD_DB_NAME=discordDB

# AbbyBot Wishlist database (wishlist)
WISHLIST_DB_HOST=wishlist.example.com
WISHLIST_DB_USER=wishlistUser
WISHLIST_DB_PASSWORD=wishlistPassword
WISHLIST_DB_NAME=wishlistDB

# AbbyBot API database (api)
API_DB_HOST=api.example.com
API_DB_USER=apiUser
API_DB_PASSWORD=apiPassword
API_DB_NAME=apiDB

# Flask secret key
SECRET_KEY=superSecretKey123

# Flask-Mail configuration
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=exampleUsername
MAIL_PASSWORD=examplePassword
MAIL_DEFAULT_SENDER=noreply@example.com